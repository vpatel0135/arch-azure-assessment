*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!terraform.tfvars.example
*.tfplan
*.plan
crash.log
crash.*.log
.terraformrc
terraform.rc
.env
.env.*
!*.example
*.pem
*.key
validation/raw/
